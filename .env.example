# Copy to .env for Compose substitution; the Go process does not load dotenv.
# Replace this placeholder with your real email or public HTTPS contact URL.
AUDIOBOOKDB_CONTACT=operator@example.com

# Existing Docker network shared with Audiobookshelf. Replace for your setup.
DOCKER_NETWORK=abs-network

# compose.host.yaml only: loopback by default; set your LAN interface explicitly.
BIND_ADDRESS=127.0.0.1
ADAPTER_PORT=8080

# compose.tls.yaml only: readable PEM server.crt/server.key/ca.crt directory.
# TLS_DIRECTORY=/absolute/path/to/certificates

# Put the AudiobookDB key in ABS's custom-provider Authorization setting.
# Development ABS credentials and key-file paths do not belong in deployment.
